datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id       Int     @id @default(autoincrement())
  email    String  @unique
  password String
  transactions Transaction[]
}

model Transaction {
  id       Int     @id @default(autoincrement())
  title    String
  amount   Float
  type     String
  category String
  userId   Int
  user     User    @relation(fields: [userId], references: [id])
}